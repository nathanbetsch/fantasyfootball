# Copy this file to .env and fill it in. .env is never committed.

SLEEPER_USERNAME=n8erdays
SEASON=2026

# ESPN private league
ESPN_LEAGUE_ID=1423797115
# From your browser cookies while logged in to fantasy.espn.com (see README)
ESPN_S2=
ESPN_SWID=
# redraft / keeper / dynasty (ESPN doesn't report this, so set it here)
ESPN_LEAGUE_TYPE=redraft

# 0.0.0.0 lets your phone on the same Wi-Fi open the dashboard; 127.0.0.1 = this PC only
HOST=0.0.0.0
PORT=5000

# Phone alerts via the free ntfy app. Pick a long random topic name.
NTFY_TOPIC=
DASHBOARD_URL=
